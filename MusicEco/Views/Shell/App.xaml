<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MusicEco.Views.Shell"
             x:Class="MusicEco.Views.Shell.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="../../Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="../../Resources/Styles/Shared.xaml" />
                <ResourceDictionary x:Name="SizeDictionary" 
                                    Source="../../Resources/Themes/WidgetSize.xaml" />
                <!--Theme must always at last-->
                <ResourceDictionary Source="../../Resources/Themes/GlobalTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
