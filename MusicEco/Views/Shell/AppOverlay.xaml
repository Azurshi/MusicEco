<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicEco.Views.Shell.AppOverlay"
             IsVisible="False">
    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="Grid_Tapped" />
        </Grid.GestureRecognizers>
        <Grid x:Name="DynamicOverlay"
              Grid.Row="0"
              Grid.Column="0"
              RowDefinitions="*, Auto, *"
              ColumnDefinitions="*, Auto, *">
            <Rectangle x:Name="OverlayBackgroound"
                       Grid.Row="0"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Grid.RowSpan="3"
                       Fill="{DynamicResource BorderColor}"
                       Opacity="0.5" />
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Margin="0"
                    Stroke="{DynamicResource BorderColor}"
                    BackgroundColor="{DynamicResource PageColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"
                                    StrokeThickness="1" />
                </Border.StrokeShape>
                <ContentView x:Name="DynamicContainer"/>
            </Border>
            <Border x:Name="DeleteButtonContainer"
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Stroke="{DynamicResource BorderColor}"
                    BackgroundColor="{DynamicResource PageColor}"
                    Margin="-8, -8"
                    WidthRequest="40"
                    HeightRequest="32">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"
                                    StrokeThickness="1" />
                </Border.StrokeShape>
                <Button Text="X"
                        Clicked="DeleteButton_Clicked" />
            </Border>
        </Grid>
        <AbsoluteLayout x:Name="FixedOverlay"
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
            <Grid x:Name="FixedViewContainer"
                  AbsoluteLayout.LayoutFlags="None">
                <Border Grid.Row="1"
                        Grid.Column="1"
                        Margin="0"
                        Stroke="{DynamicResource BorderColor}"
                        BackgroundColor="{DynamicResource PageColor}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"
                                        StrokeThickness="1" />
                    </Border.StrokeShape>
                    <ContentView x:Name="FixedContainer" />
                </Border>
            </Grid>
        </AbsoluteLayout>
    </Grid>
</ContentView>
