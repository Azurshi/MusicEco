<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             xmlns:top="clr-namespace:MusicEco"
             x:Name="Root"
             x:Class="MusicEco.Views.Buttons.FavouriteControlButton"
             ActiveTintColor="{DynamicResource ActiveTintColor}"
             InactiveTintColor="{DynamicResource InactiveTintColor}">
    <ContentView.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnTapped" />
        <PointerGestureRecognizer PointerPressed="OnPointerPressed"
                                  PointerReleased="OnPointerReleased"
                                  PointerEntered="OnPointerEntered"
                                  PointerExited="OnPointerExited" />
    </ContentView.GestureRecognizers>
    <control:SKImageLabel x:Name="ImageLabel"
                          Option="{Static top:SamplingOptions.Trilinear}"
                          MaxSize="{Static top:Config.MaxIconButtonSize}" 
                          ResourcePath="{Binding ResourcePath, Source={Reference Root}}"/>
</ContentView>
