<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             xmlns:top="clr-namespace:MusicEco"
             x:Name="Root"
             x:Class="MusicEco.Views.Buttons.NavigationBackwardButton"
             HeightRequest="{DynamicResource HeaderSize}"
             WidthRequest="{DynamicResource HeaderSize}"
             SizeRequest="{DynamicResource HeaderSize}"
             Padding="0">
    <control:SKImageButton x:Name="InnerButton"
                           ResourcePath="next_raw.png"
                           Rotation="180"
                           DisplayMode="DualTint"
                           ActiveTintColor="{DynamicResource ActiveTintColor}"
                           InactiveTintColor="{DynamicResource InactiveTintColor}"
                           WidthRequest="{Binding InnerButtonSize, Source={Reference Root}}"
                           HeightRequest="{Binding InnerButtonSize, Source={Reference Root}}"/>
</ContentView>
