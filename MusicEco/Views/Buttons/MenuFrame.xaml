<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicEco.Views.Buttons.MenuFrame">
    <Border Stroke="{DynamicResource BorderColor}"
            BackgroundColor="{DynamicResource MenuBackgroundColor}"
            Padding="4"
            x:Name="Container">
        <Border.StrokeShape>
            <RoundRectangle StrokeThickness="1"
                            CornerRadius="8" />
        </Border.StrokeShape>
    </Border>
</ContentView>
