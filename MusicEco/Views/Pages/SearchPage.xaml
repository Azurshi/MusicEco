<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageVM="clr-namespace:MusicEco.ViewModels.Pages"
             xmlns:itemVM="clr-namespace:MusicEco.ViewModels.Items"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             x:Class="MusicEco.Views.Pages.SearchPage"
             x:DataType="pageVM:SearchPageViewModel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Entry Grid.Row="0" 
               Text="{Binding SearchText, Mode=TwoWay}"/>
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="itemVM:AudioEntryViewModel">
                    <Grid HeightRequest="{DynamicResource IconItemSize}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <control:ManagedIcon Grid.Column="0"
                                             WidthRequest="{DynamicResource IconItemSize}"
                                             FileHash="{Binding FileHash}"
                                             Option="Small" />
                        <Label Grid.Column="1"
                               Text="{Binding DisplayTitle}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentView>
