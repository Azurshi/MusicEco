<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageVM="clr-namespace:MusicEco.ViewModels.Pages"
             xmlns:itemVM="clr-namespace:MusicEco.ViewModels.Items"
             xmlns:item="clr-namespace:MusicEco.Views.Items"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             xmlns:button="clr-namespace:MusicEco.Views.Buttons"
             xmlns:selector="clr-namespace:MusicEco.Views.TemplateSelector"
             x:Class="MusicEco.Views.Pages.ExplorerTreePage"
             x:DataType="pageVM:ExplorerTreePageViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="ListFolderItemTemplate"
                          x:DataType="itemVM:FolderEntryViewModel">
                <item:ItemFrame HeightRequest="{DynamicResource IconItemSize}"
                                Command="{Binding SelectFolderCommand, Source={RelativeSource AncestorType={x:Type pageVM:ExplorerTreePageViewModel}}}">
                    <item:ItemFrame.ItemContent>
                        <Grid>
                            <Label Text="{Binding Name}"
                                   Style="{StaticResource OneLine}" />
                        </Grid>
                    </item:ItemFrame.ItemContent>
                </item:ItemFrame>
            </DataTemplate>
            <DataTemplate x:Key="ListFileItemTemplate"
                          x:DataType="itemVM:FileEntryViewModel">
                <item:ItemFrame HeightRequest="{DynamicResource IconItemSize}"
                                Command="{Binding SelectFileCommand, Source={RelativeSource AncestorType={x:Type pageVM:ExplorerTreePageViewModel}}}">
                    <item:ItemFrame.ItemContent>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <control:ManagedIcon Grid.Column="0"
                                                 FileHash="{Binding FileHash}"
                                                 WidthRequest="{DynamicResource IconItemSize}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   Style="{StaticResource OneLine}" />
                            <Button Grid.Column="2"
                                    Text=":"
                                    WidthRequest="{DynamicResource IconButtonItemSize}" />
                        </Grid>
                    </item:ItemFrame.ItemContent>
                </item:ItemFrame>
            </DataTemplate>
            <selector:ExplorerTemplateSelector x:Key="ListItemSelector"
                                               FolderTemplate="{StaticResource ListFolderItemTemplate}"
                                               FileTemplate="{StaticResource ListFileItemTemplate}" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              ColumnSpacing="8"
              HeightRequest="{DynamicResource HeaderSize}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <button:NavigationBackwardButton Grid.Column="0" />
            <Button Grid.Column="1"
                    Text="Refresh" 
                    Command="{Binding RefreshFolderCommand}"/>
            <Button Grid.Column="2"
                    Text="Previous" 
                    Command="{Binding PreviousFolderCommand}"/>
            <Button Grid.Column="3"
                    Text="Next"
                    Command="{Binding NextFolderCommand}"/>
            <Button Grid.Column="4"
                    Text="Up" 
                    Command="{Binding UpFolderCommand}"/>
            <Label Grid.Column="5"
                   Text="{Binding FolderPath}"
                   Style="{StaticResource OneLine}"
                   Margin="8, 0, 0, 0" />
        </Grid>
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items.Items}"
                        ItemTemplate="{StaticResource ListItemSelector}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="8" />
            </CollectionView.ItemsLayout>
        </CollectionView>
    </Grid>
</ContentView>
