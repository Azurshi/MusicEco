<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:service="clr-namespace:MusicEco.Services"
             xmlns:pageVM="clr-namespace:MusicEco.ViewModels.Pages"
             xmlns:itemVM="clr-namespace:MusicEco.ViewModels.Items"
             xmlns:item="clr-namespace:MusicEco.Views.Items"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             xmlns:button="clr-namespace:MusicEco.Views.Buttons"
             xmlns:commands="clr-namespace:MusicEco.Views.Commands"
             xmlns:selector="clr-namespace:MusicEco.Views.TemplateSelector"
             x:Class="MusicEco.Views.Pages.ExplorerTreePage"
             x:DataType="pageVM:ExplorerTreePageViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="FolderMenuTemplate"
                          x:DataType="itemVM:FolderEntryViewModel">
                <VerticalStackLayout>
                    <VerticalStackLayout>
                        <button:MenuItemButton Text="{Binding [Common_Play], Source={Static service:Localization.L}}"
                                               Command="{Static commands:MenuCommands.PlayListCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </DataTemplate>
            <DataTemplate x:Key="FileMenuTemplate"
                          x:DataType="itemVM:FileEntryViewModel">
                <VerticalStackLayout>
                    <button:FavouriteMenuItemButton />
                    <button:MenuItemButton Text="{Binding [Menu_AddToQueue], Source={Static service:Localization.L}}"
                                           Command="{Static commands:MenuCommands.AddToQueueCommand}" />
                    <button:MenuItemButton Text="{Binding [Menu_AddToPlaylist], Source={Static service:Localization.L}}"
                                           Command="{Static commands:MenuCommands.AddToPlaylistCommand}" />
                    <button:MenuItemButton Text="{Binding [Menu_Info], Source={Static service:Localization.L}}"
                                           Command="{Static commands:MenuCommands.ShowAudioInfoCommand}" />
                </VerticalStackLayout>
            </DataTemplate>
            <DataTemplate x:Key="ListFolderItemTemplate"
                          x:DataType="itemVM:FolderEntryViewModel">
                <item:ItemFrame HeightRequest="{DynamicResource IconItemSize}"
                                BackgroundColor="{Binding BackgroundColor}"
                                Command="{Binding SelectFolderCommand, Source={RelativeSource AncestorType={x:Type pageVM:ExplorerTreePageViewModel}}}">
                    <item:ItemFrame.ItemContent>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" 
                                   Text="{Binding Name}"
                                   Style="{StaticResource OneLine}" />
                            <item:MenuButton Grid.Column="1"
                                             WidthRequest="{DynamicResource IconButtonItemSize}"
                                             MenuTemplate="{StaticResource FolderMenuTemplate}" />
                        </Grid>
                    </item:ItemFrame.ItemContent>
                </item:ItemFrame>
            </DataTemplate>
            <DataTemplate x:Key="ListFileItemTemplate"
                          x:DataType="itemVM:FileEntryViewModel">
                <item:ItemFrame HeightRequest="{DynamicResource IconItemSize}"
                                BackgroundColor="{Binding BackgroundColor}"
                                Command="{Binding SelectFileCommand, Source={RelativeSource AncestorType={x:Type pageVM:ExplorerTreePageViewModel}}}">
                    <item:ItemFrame.ItemContent>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <control:ManagedSKIcon Grid.Column="0"
                                                 FileHash="{Binding FileHash}"
                                                 WidthRequest="{DynamicResource IconItemSize}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   Style="{StaticResource OneLine}" />
                            <item:MenuButton Grid.Column="2"
                                             WidthRequest="{DynamicResource IconButtonItemSize}"
                                             MenuTemplate="{StaticResource FileMenuTemplate}" />
                        </Grid>
                    </item:ItemFrame.ItemContent>
                </item:ItemFrame>
            </DataTemplate>
            <selector:ExplorerTemplateSelector x:Key="ListItemSelector"
                                               FolderTemplate="{StaticResource ListFolderItemTemplate}"
                                               FileTemplate="{StaticResource ListFileItemTemplate}" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              ColumnSpacing="8"
              HeightRequest="{DynamicResource HeaderSize}"
              BackgroundColor="{DynamicResource HeaderColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <button:NavigationBackwardButton Grid.Column="0" />
            <Button Grid.Column="1"
                    Text="Refresh" 
                    Command="{Binding RefreshFolderCommand}"/>
            <Button Grid.Column="2"
                    Text="Previous" 
                    Command="{Binding PreviousFolderCommand}"/>
            <Button Grid.Column="3"
                    Text="Next"
                    Command="{Binding NextFolderCommand}"/>
            <Button Grid.Column="4"
                    Text="Up" 
                    Command="{Binding UpFolderCommand}"/>
            <Label Grid.Column="5"
                   Text="{Binding FolderPath}"
                   Style="{StaticResource OneLine}"
                   Margin="8, 0, 0, 0" />
        </Grid>
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items.Items}"
                        ItemTemplate="{StaticResource ListItemSelector}"
                        ItemsLayout="{StaticResource LinearLayout}" />
    </Grid>
</ContentView>
