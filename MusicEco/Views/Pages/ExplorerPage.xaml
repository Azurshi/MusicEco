<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageVM="clr-namespace:MusicEco.ViewModels.Pages"
             xmlns:itemVM="clr-namespace:MusicEco.ViewModels.Items"
             xmlns:item="clr-namespace:MusicEco.Views.Items"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             xmlns:button="clr-namespace:MusicEco.Views.Buttons"
             x:Class="MusicEco.Views.Pages.ExplorerPage"
             x:DataType="pageVM:ExplorerPageViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="ScanPathItemTemplate"
                          x:DataType="itemVM:ScanPathViewModel">
                <item:ItemFrame HeightRequest="{DynamicResource IconItemSize}"
                                BackgroundColor="{Binding BackgroundColor}"
                                Command="{Binding SelectItemCommand, Source={RelativeSource AncestorType={x:Type pageVM:ExplorerPageViewModel}}}">
                    <item:ItemFrame.ItemContent>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <control:TextLabel Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontAttributes="Bold"
                                               IsAnimationEnabled="{Binding IsVisibleInViewport}" />
                            <ContentView Grid.Row="1"
                                         Margin="{DynamicResource TextMargin}">
                                <control:TextLabel Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="{Binding Path}"
                                                   IsAnimationEnabled="{Binding IsVisibleInViewport}"
                                                   Opacity="0.75" />
                            </ContentView>
                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Grid.RowSpan="2"
                                    WidthRequest="{DynamicResource ItemButtonSize}"
                                    Text="X"
                                    IsVisible="{Binding IsUnlocked}"
                                    Command="{Binding DeleteItemCommand, Source={RelativeSource AncestorType={x:Type pageVM:ExplorerPageViewModel}}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </item:ItemFrame.ItemContent>
                </item:ItemFrame>
            </DataTemplate>
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              IsVisible="{Binding IsUnLocked}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Style="{StaticResource Highlight}"
                    Text="{Binding L[Explorer_Scan]}"
                    Command="{Binding ScanCommand}" />
            <Button Grid.Column="1"
                    Style="{StaticResource Highlight}"
                    Command="{Binding AddNewPathCommand}"
                    Text="{Binding L[Explorer_AddFolder]}" />
        </Grid>
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              HeightRequest="-1"
              IsVisible="{Binding IsLocked}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0"
                   Grid.Column="0"
                   Text="{Binding L[Explorer_FileScan]}"
                   Style="{StaticResource OneLine}" />
            <Label Grid.Row="1"
                   Grid.Column="0"
                   Text="{Binding L[Explorer_FileProcess]}"
                   Style="{StaticResource OneLine}" />
            <Label Grid.Row="2"
                   Grid.Column="0"
                   Text="{Binding L[Explorer_SaveData]}"
                   Style="{StaticResource OneLine}" />
            <ProgressBar Grid.Row="0"
                         Grid.Column="1"
                         Progress="{Binding ProgressInfo.ScanFileProgress}" />
            <ProgressBar Grid.Row="1"
                         Grid.Column="1"
                         Progress="{Binding ProgressInfo.ProcessFileProgress}" />
            <ProgressBar Grid.Row="2"
                         Grid.Column="1"
                         Progress="{Binding ProgressInfo.SaveDataProgress}" />
            <Label Grid.Row="0"
                   Grid.Column="2"
                   Text="{Binding ProgressInfo.ScanFileProgressText}"
                   Style="{StaticResource OneLine}" />
            <Label Grid.Row="1"
                   Grid.Column="2"
                   Text="{Binding ProgressInfo.ProcessFileProgressText}"
                   Style="{StaticResource OneLine}" />
            <Label Grid.Row="2"
                   Grid.Column="2"
                   Text="{Binding ProgressInfo.SaveDataProgressText}"
                   Style="{StaticResource OneLine}" />
        </Grid>
        <Grid Grid.Row="1"
              Style="{StaticResource HeaderGrid}">
            <control:TextLabel Text="{Binding L[Explorer_DisplayText]}"
                               Style="{StaticResource TextLabel}"/>
        </Grid>
        <Rectangle Grid.Row="2"
                   Style="{StaticResource HorizontalSeparator}" />
        <control:CollectionViewExtend Grid.Row="3"
                                      DisplayMode="SimpleList"
                                      ItemsSource="{Binding Items.Items}"
                                      Margin="{DynamicResource PageContentMargin}">
            <control:CollectionViewExtend.ItemPresets>
                <control:CollectionViewPreset DisplayMode="SimpleList"
                                              ItemTemplate="{StaticResource ScanPathItemTemplate}"
                                              ItemsLayout="{StaticResource LinearLayout}" />
            </control:CollectionViewExtend.ItemPresets>
        </control:CollectionViewExtend>
    </Grid>
</ContentView>
