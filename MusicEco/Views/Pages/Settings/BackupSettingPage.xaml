<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageVM="clr-namespace:MusicEco.ViewModels.Pages"
             xmlns:settingPageVM="clr-namespace:MusicEco.ViewModels.Pages.Settings"
             xmlns:itemVM="clr-namespace:MusicEco.ViewModels.Items"
             xmlns:item="clr-namespace:MusicEco.Views.Items"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             xmlns:button="clr-namespace:MusicEco.Views.Buttons"
             x:Class="MusicEco.Views.Pages.Settings.BackupSettingPage"
             x:DataType="settingPageVM:BackupSetttingPageViewModel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}">
            <Label Grid.Row="0"
                   Text="{Binding L[Setting_Backup]}"
                   Style="{StaticResource Title}" />
        </Grid>
        <Rectangle Grid.Row="1"
                   Style="{StaticResource HorizontalSeparator}" />
        <ScrollView Grid.Row="2"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Default"
                    Margin="{DynamicResource PageContentMargin}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0"
                        Style="{StaticResource Highlight}"
                        HeightRequest="{DynamicResource ItemButtonSize}"
                        Text="{Binding L[Setting_Backup_DeleteData]}"
                        Command="{Binding DeleteAllDataCommand}"/>
            </Grid>
        </ScrollView>
    </Grid>
</ContentView>
