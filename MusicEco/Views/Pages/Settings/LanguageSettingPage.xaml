<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageVM="clr-namespace:MusicEco.ViewModels.Pages"
             xmlns:settingPageVM="clr-namespace:MusicEco.ViewModels.Pages.Settings"
             xmlns:itemVM="clr-namespace:MusicEco.ViewModels.Items"
             xmlns:item="clr-namespace:MusicEco.Views.Items"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             xmlns:button="clr-namespace:MusicEco.Views.Buttons"
             x:Class="MusicEco.Views.Pages.Settings.LanguageSettingPage"
             x:DataType="settingPageVM:LanguageSettingPageViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="ListLanguageItemTemplate"
                          x:DataType="itemVM:LanguageViewModel">
                <item:ItemFrame HeightRequest="{DynamicResource TextItemSize}"
                                Command="{Binding SelectLanguageCommand, Source={RelativeSource AncestorType={x:Type settingPageVM:LanguageSettingPageViewModel}}}"
                                IsSelected="{Binding Selected}">
                    <item:ItemFrame.ItemContent>
                        <Label Text="{Binding LanguageName}"
                               Style="{StaticResource OneLine}"
                               Margin="{DynamicResource TextMargin}"/>
                    </item:ItemFrame.ItemContent>
                </item:ItemFrame>
            </DataTemplate>
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <button:NavigationBackwardButton Grid.Column="0" 
                                             WidthRequest="{DynamicResource HeaderSize}"/>
            <Label Grid.Column="1" 
                   Text="{Binding L[Language_Current]}"
                   Style="{StaticResource Title}"/>
            <Label Grid.Column="2"
                   Text="{Binding L[Language]}"
                   Style="{StaticResource OneLine}" 
                   FontAttributes="Bold"/>
        </Grid>
        <Rectangle Grid.Row="1"
                   Style="{StaticResource HorizontalSeparator}" />
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Languages}"
                        ItemTemplate="{StaticResource ListLanguageItemTemplate}"
                        ItemsLayout="{StaticResource LinearLayout}" />
    </Grid>
</ContentView>
