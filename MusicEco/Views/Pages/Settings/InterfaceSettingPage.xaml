<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageVM="clr-namespace:MusicEco.ViewModels.Pages"
             xmlns:settingPageVM="clr-namespace:MusicEco.ViewModels.Pages.Settings"
             xmlns:itemVM="clr-namespace:MusicEco.ViewModels.Items"
             xmlns:item="clr-namespace:MusicEco.Views.Items"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             xmlns:button="clr-namespace:MusicEco.Views.Buttons"
             x:Class="MusicEco.Views.Pages.Settings.InterfaceSettingPage"
             x:DataType="settingPageVM:InterfaceSettingPageViewModel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <button:NavigationBackwardButton Grid.Column="0"
                                             WidthRequest="{DynamicResource HeaderSize}" />
            <Label Grid.Column="1"
                   Text="{Binding L[Setting_Interface]}"
                   Style="{StaticResource Title}" />
        </Grid>
        <Rectangle Grid.Row="1"
                   Style="{StaticResource HorizontalSeparator}" />
        <Grid Grid.Row="2"
              RowSpacing="{DynamicResource ListSpacing}"
              ColumnSpacing="{DynamicResource ItemsGridSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0"
                   Text="{Binding L[Setting_Interface_Theme]}"
                   Style="{DynamicResource OneLine}"
                   Margin="{DynamicResource TextMargin}"/>
            <Picker Grid.Row="0"
                    Grid.Column="2"
                    ItemsSource="{Binding Themes}"
                    SelectedItem="{Binding CurrentTheme, Mode=TwoWay}"
                    Title="{Binding ThemePickerTitle}" />
            <Rectangle Grid.Row="1"
                       Grid.ColumnSpan="3"
                       Style="{StaticResource HorizontalSeparator}" />
            <Label Grid.Row="2"
                   Text="{Binding L[Setting_Interface_Scale]}"
                   Style="{DynamicResource OneLine}"
                   Margin="{DynamicResource TextMargin}" />
            <Picker Grid.Row="2"
                    Grid.Column="2"
                    ItemsSource="{Binding Scales}"
                    SelectedItem="{Binding CurrentScale, Mode=TwoWay}"
                    Title="{Binding ScalePickerTitle}" />
            <Rectangle Grid.Row="3"
                       Grid.ColumnSpan="3"
                       Style="{StaticResource HorizontalSeparator}" />
            <Label Grid.Row="4"
                   Text="{Binding L[Setting_Interface_Orientation]}"
                   Style="{DynamicResource OneLine}"
                   Margin="{DynamicResource TextMargin}" />
            <Picker Grid.Row="4"
                    Grid.Column="2"
                    ItemsSource="{Binding Orientations}"
                    SelectedItem="{Binding CurrentOrientation, Mode=TwoWay}"
                    Title="{Binding OrientationPickerTitle}" />
            <Rectangle Grid.Row="5"
                       Grid.ColumnSpan="3"
                       Style="{StaticResource HorizontalSeparator}" />
        </Grid>
    </Grid>
</ContentView>
