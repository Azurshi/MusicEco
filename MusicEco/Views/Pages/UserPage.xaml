<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageVM="clr-namespace:MusicEco.ViewModels.Pages"
             xmlns:itemVM="clr-namespace:MusicEco.ViewModels.Items"
             xmlns:item="clr-namespace:MusicEco.Views.Items"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             xmlns:button="clr-namespace:MusicEco.Views.Buttons"
             xmlns:top="clr-namespace:MusicEco"
             x:Class="MusicEco.Views.Pages.UserPage"
             x:DataType="pageVM:UserPageViewModel">
    <Grid>
        <ScrollView Grid.Row="0" 
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Default">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0"
                        Text="{Binding L[User_Playlist]}"
                        HeightRequest="{DynamicResource ButtonSize}" 
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{Static top:PageRoute.Playlist}"/>
                <Button Grid.Row="1"
                        Text="{Binding L[User_Favourite]}"
                        HeightRequest="{DynamicResource ButtonSize}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{Static top:PageRoute.Favourite}" />
                <Button Grid.Row="2"
                        Text="{Binding L[User_Recent]}"
                        HeightRequest="{DynamicResource ButtonSize}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{Static top:PageRoute.PlayHistory}" />
                <Button Grid.Row="3"
                        Text="{Binding L[User_Most]}"
                        HeightRequest="{DynamicResource ButtonSize}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{Static top:PageRoute.PlayCount}" />
                <Button Grid.Row="4"
                        Text="{Binding L[User_Not]}"
                        HeightRequest="{DynamicResource ButtonSize}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{Static top:PageRoute.NotPlay}" />
                <Button Grid.Row="5"
                        Text="{Binding L[User_All]}"
                        HeightRequest="{DynamicResource ButtonSize}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{Static top:PageRoute.AllSong}" />
            </Grid>
        </ScrollView>
    </Grid>
</ContentView>
