<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:service="clr-namespace:MusicEco.Services"
             xmlns:pageVM="clr-namespace:MusicEco.ViewModels.Pages"
             xmlns:userVM="clr-namespace:MusicEco.ViewModels.Pages.Users"
             xmlns:itemVM="clr-namespace:MusicEco.ViewModels.Items"
             xmlns:item="clr-namespace:MusicEco.Views.Items"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             xmlns:button="clr-namespace:MusicEco.Views.Buttons"
             xmlns:commands="clr-namespace:MusicEco.Views.Commands"
             x:Class="MusicEco.Views.Pages.Users.PlaylistPage"
             x:DataType="userVM:PlaylistPageViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="MenuTemplate"
                          x:DataType="itemVM:PlaylistItemViewModel">
                <VerticalStackLayout>
                    <button:MenuItemButton Text="{Binding [Common_Play], Source={Static service:Localization.L}}"
                                           Command="{Static commands:MenuCommands.PlayListCommand}" />
                </VerticalStackLayout>
            </DataTemplate>
            <DataTemplate x:Key="ListItemViewModel"
                          x:DataType="itemVM:PlaylistItemViewModel">
                <item:ItemFrame HeightRequest="{DynamicResource TextItemSize}"
                                BackgroundColor="{Binding BackgroundColor}"
                                Command="{Binding SelectItemCommand, Source={RelativeSource AncestorType={x:Type userVM:PlaylistPageViewModel}}}">
                    <item:ItemFrame.ItemContent>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <control:TextLabel Grid.Column="0"
                                               Text="{Binding Name}"
                                               IsAnimationEnabled="{Binding IsVisibleInViewport}" />
                            <item:MenuButton Grid.Column="1"
                                             Style="{StaticResource ListMenuButton}"
                                             WidthRequest="{DynamicResource TextItemSize}" />
                        </Grid>
                    </item:ItemFrame.ItemContent>
                </item:ItemFrame>
            </DataTemplate>
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <button:NavigationBackwardButton Grid.Column="0"
                                             WidthRequest="{DynamicResource HeaderSize}" />
            <Entry Grid.Column="1"
                   Placeholder="{Binding L[User_Playlist_Name]}"
                   Text="{Binding Query.Name, Mode=TwoWay}" />
            <Button Grid.Column="2"
                    Style="{StaticResource Highlight}"
                    Text="{Binding L[User_Playlist_Create]}"
                    Command="{Static commands:MenuCommands.CreateNewPlaylistCommand}" />
        </Grid>
        <Rectangle Grid.Row="1"
                   Style="{StaticResource HorizontalSeparator}" />
        <control:CollectionViewExtend Grid.Row="2"
                                      DisplayMode="{Binding DisplayMode}"
                                      ItemsSource="{Binding Items.Items}"
                                      Margin="{DynamicResource PageContentMargin}">
            <control:CollectionViewExtend.ItemPresets>
                <control:CollectionViewPreset DisplayMode="SimpleList"
                                              ItemTemplate="{StaticResource ListItemViewModel}"
                                              ItemsLayout="{StaticResource LinearLayout}">
                </control:CollectionViewPreset>
            </control:CollectionViewExtend.ItemPresets>
        </control:CollectionViewExtend>
    </Grid>
</ContentView>
