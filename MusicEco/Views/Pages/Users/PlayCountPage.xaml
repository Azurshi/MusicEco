<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:service="clr-namespace:MusicEco.Services"
             xmlns:pageVM="clr-namespace:MusicEco.ViewModels.Pages"
             xmlns:userVM="clr-namespace:MusicEco.ViewModels.Pages.Users"
             xmlns:itemVM="clr-namespace:MusicEco.ViewModels.Items"
             xmlns:item="clr-namespace:MusicEco.Views.Items"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             xmlns:button="clr-namespace:MusicEco.Views.Buttons"
             xmlns:commands="clr-namespace:MusicEco.Views.Commands"
             x:Class="MusicEco.Views.Pages.Users.PlayCountPage"
             x:DataType="userVM:PlayCountPageViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="MenuTemplate"
                          x:DataType="itemVM:PlayCountViewModel">
                <VerticalStackLayout>
                    <button:FavouriteMenuItemButton />
                    <button:MenuItemButton Text="{Binding [Menu_AddToQueue], Source={Static service:Localization.L}}"
                                           Command="{Static commands:MenuCommands.AddToQueueCommand}" />
                    <button:MenuItemButton Text="{Binding [Menu_AddToPlaylist], Source={Static service:Localization.L}}"
                                           Command="{Static commands:MenuCommands.AddToPlaylistCommand}" />
                    <button:MenuItemButton Text="{Binding [Menu_Info], Source={Static service:Localization.L}}"
                                           Command="{Static commands:MenuCommands.ShowAudioInfoCommand}" />
                </VerticalStackLayout>
            </DataTemplate>
            <DataTemplate x:Key="PlayCountItemTemplate"
                          x:DataType="itemVM:PlayCountViewModel">
                <item:ItemFrame HeightRequest="{DynamicResource IconItemSize}"
                                BackgroundColor="{Binding BackgroundColor}"
                                Command="{Binding SelectItemCommand, Source={RelativeSource AncestorType={x:Type userVM:PlayCountPageViewModel}}}">
                    <item:ItemFrame.ItemContent>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <control:ManagedSKIcon Grid.Column="0"
                                                   WidthRequest="{DynamicResource IconItemSize}"
                                                   FileHash="{Binding FileHash}"
                                                   Option="Small" />
                            <control:TextLabel Grid.Column="1"
                                               Text="{Binding DisplayTitle}"
                                               IsAnimationEnabled="{Binding IsVisibleInViewport}" />
                            <Label Grid.Column="2"
                                   Text="{Binding PlayCountText}"
                                   Style="{StaticResource OneLine}"
                                   HorizontalTextAlignment="Center"
                                   WidthRequest="{DynamicResource IconItemSize}" />
                            <item:MenuButton Grid.Column="3"
                                             Style="{StaticResource ListMenuButton}"
                                             MenuTemplate="{StaticResource MenuTemplate}" />
                        </Grid>
                    </item:ItemFrame.ItemContent>
                </item:ItemFrame>
            </DataTemplate>
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <button:NavigationBackwardButton Grid.Column="0"
                                             WidthRequest="{DynamicResource HeaderSize}" />
            <Label Grid.Column="1"
                   Text="{Binding L[User_Most_Title]}"
                   Style="{StaticResource Title}" />
        </Grid>
        <Rectangle Grid.Row="1"
                   Style="{StaticResource HorizontalSeparator}" />
        <control:CollectionViewExtend Grid.Row="2"
                                      DisplayMode="SimpleList"
                                      ItemsSource="{Binding Items.Items}"
                                      Margin="{DynamicResource PageContentMargin}">
            <control:CollectionViewExtend.ItemPresets>
                <control:CollectionViewPreset DisplayMode="SimpleList"
                                              ItemTemplate="{StaticResource PlayCountItemTemplate}"
                                              ItemsLayout="{StaticResource LinearLayout}" />
            </control:CollectionViewExtend.ItemPresets>
        </control:CollectionViewExtend>
    </Grid>
</ContentView>
