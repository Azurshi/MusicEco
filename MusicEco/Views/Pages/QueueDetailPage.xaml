<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:service="clr-namespace:MusicEco.Services"
             xmlns:pageVM="clr-namespace:MusicEco.ViewModels.Pages"
             xmlns:itemVM="clr-namespace:MusicEco.ViewModels.Items"
             xmlns:item="clr-namespace:MusicEco.Views.Items"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             xmlns:button="clr-namespace:MusicEco.Views.Buttons"
             xmlns:commands="clr-namespace:MusicEco.Views.Commands"
             x:Class="MusicEco.Views.Pages.QueueDetailPage"
             x:DataType="pageVM:QueueDetailPageViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="MenuTemplate"
                          x:DataType="itemVM:AudioEntryViewModel">
                <VerticalStackLayout>
                    <button:FavouriteMenuItemButton />
                    <button:MenuItemButton Text="{Binding [Menu_RemoveFromQueue], Source={Static service:Localization.L}}"
                                           Tapped="MenuItemButton_Tapped" />
                    <button:MenuItemButton Text="{Binding [Menu_AddToQueue], Source={Static service:Localization.L}}"
                                           Command="{Static commands:MenuCommands.AddToQueueCommand}" />
                    <button:MenuItemButton Text="{Binding [Menu_AddToPlaylist], Source={Static service:Localization.L}}"
                                           Command="{Static commands:MenuCommands.AddToPlaylistCommand}" />
                    <button:MenuItemButton Text="{Binding [Menu_Info], Source={Static service:Localization.L}}"
                                           Command="{Static commands:MenuCommands.ShowAudioInfoCommand}" />
                </VerticalStackLayout>
            </DataTemplate>
            <DataTemplate x:Key="AudioItemTemplate"
                          x:DataType="itemVM:AudioEntryViewModel">
                <item:DragItemFrame HeightRequest="{DynamicResource IconItemSize}"
                                    BackgroundColor="{Binding BackgroundColor}"
                                    IsSelected="{Binding Selected}"
                                    Command="{Binding SelectItemCommand, Source={RelativeSource AncestorType={x:Type pageVM:QueueDetailPageViewModel}}}"
                                    DragStartCommand="{Binding DragItemCommand, Source={RelativeSource AncestorType={x:Type pageVM:QueueDetailPageViewModel}}}"
                                    DropCommand="{Binding DropItemCommand, Source={RelativeSource AncestorType={x:Type pageVM:QueueDetailPageViewModel}}}">
                    <item:DragItemFrame.ItemContent>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <button:MoveButton Grid.Column="0"
                                               WidthRequest="{DynamicResource IconButtonItemSize}"
                                               IsDraggable="{Binding IsDraggable}" />
                            <control:ManagedSKIcon Grid.Column="1"
                                                   WidthRequest="{DynamicResource IconItemSize}"
                                                   FileHash="{Binding FileHash}"
                                                   Option="Small" />
                            <Label Grid.Column="2"
                                   Text="{Binding DisplayTitle}"
                                   Style="{StaticResource OneLine}" />
                            <item:MenuButton Grid.Column="3"
                                             WidthRequest="{DynamicResource IconButtonItemSize}"
                                             MenuTemplate="{StaticResource MenuTemplate}" />
                        </Grid>
                    </item:DragItemFrame.ItemContent>
                </item:DragItemFrame>
            </DataTemplate>
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              ColumnSpacing="8"
              HeightRequest="{DynamicResource HeaderSize}"
              BackgroundColor="{DynamicResource HeaderColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <button:NavigationBackwardButton Grid.Column="0"
                                             WidthRequest="{DynamicResource HeaderSize}"
                                             Margin="4, 8" />
            <Label Grid.Column="1"
                   Text="{Binding QueueName}"
                   Style="{StaticResource OneLine}" />
        </Grid>
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items.Items}"
                        ItemTemplate="{StaticResource AudioItemTemplate}"
                        ItemsLayout="{StaticResource LinearLayout}">
            <CollectionView.GestureRecognizers>
                <DropGestureRecognizer Drop="DropGestureRecognizer_Drop" />
            </CollectionView.GestureRecognizers>
        </CollectionView>
    </Grid>
</ContentView>
