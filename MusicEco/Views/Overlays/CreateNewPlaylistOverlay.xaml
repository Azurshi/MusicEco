<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:service="clr-namespace:MusicEco.Services"
             xmlns:overlayVM="clr-namespace:MusicEco.ViewModels.Overlays"
             xmlns:pageVM="clr-namespace:MusicEco.ViewModels.Pages"
             xmlns:itemVM="clr-namespace:MusicEco.ViewModels.Items"
             xmlns:item="clr-namespace:MusicEco.Views.Items"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             xmlns:button="clr-namespace:MusicEco.Views.Buttons"
             xmlns:commands="clr-namespace:MusicEco.Views.Commands"
             x:Class="MusicEco.Views.Overlays.CreateNewPlaylistOverlay"
             x:DataType="overlayVM:CreateNewPlaylistOverlayViewModel">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Grid.Row="0"
               Grid.ColumnSpan="2"
               HeightRequest="{DynamicResource HeaderSize}"
               Text="{Binding L[User_Playlist_Info]}"
               FontAttributes="Bold"
               FontSize="20"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center" />
        <Label Grid.Row="1"
               HeightRequest="{DynamicResource TextItemSize}"
               Text="{Binding L[User_Playlist_Name]}"
               FontAttributes="Bold"
               Style="{StaticResource OneLine}" />
        <Entry Grid.Row="1"
               Grid.Column="1"
               Text="{Binding PlaylistName, Mode=TwoWay}"
               HeightRequest="{DynamicResource TextItemSize}"
               Placeholder="{Binding L[User_Playlist_Placeholder]}" />
        <Grid Grid.Row="3"
              Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1"
                    Text="{Binding L[Common_Confirm]}"
                    Command="{Binding ConfirmCommand}" />
            <Button Grid.Column="2"
                    Text="{Binding L[Common_Cancel]}"
                    Command="{Binding CancelCommand}" />
        </Grid>
    </Grid>
</ContentView>
