<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageVM="clr-namespace:MusicEco.ViewModels.Pages"
             xmlns:overlayVM="clr-namespace:MusicEco.ViewModels.Overlays"
             xmlns:itemVM="clr-namespace:MusicEco.ViewModels.Items"
             xmlns:item="clr-namespace:MusicEco.Views.Items"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             xmlns:button="clr-namespace:MusicEco.Views.Buttons"
             x:Class="MusicEco.Views.Overlays.ChangeVolumeOverlay"
             x:DataType="overlayVM:ChangeVolumeOverlayViewModel"
             Margin="8, 4">
    <Grid WidthRequest="{DynamicResource ProgressBarSize}"
          HeightRequest="{DynamicResource VolumeBarSize}">
        <Slider Minimum="0"
                Maximum="1"
                Value="{Binding Volume, Mode=TwoWay}"
                WidthRequest="{DynamicResource VolumeBarSize}"
                Rotation="-90"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
    </Grid>
</ContentView>
