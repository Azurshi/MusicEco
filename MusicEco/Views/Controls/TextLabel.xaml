<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicEco.Views.Controls.TextLabel"
             x:Name="Root" >
    <AbsoluteLayout x:Name="Viewport"
                    IsClippedToBounds="True"
                    Margin="{DynamicResource TextMargin}">
        <Label x:Name="TextElement"
               AbsoluteLayout.LayoutBounds="0, 0.5, AutoSize, AutoSize"
               AbsoluteLayout.LayoutFlags="YProportional"
               HorizontalOptions="Start"
               LineBreakMode="NoWrap"
               MaxLines="1"
               TextColor="{DynamicResource TextColor}"
               Text="{Binding Text, Source={Reference Root}}" 
               FontSize="{Binding FontSize, Source={Reference Root}}"
               FontAttributes="{Binding FontAttributes, Source={Reference Root}}"/>
    </AbsoluteLayout>
</ContentView>
