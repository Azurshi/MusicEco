<?xml version="1.0" encoding="utf-8" ?>
<control:SKImageLabel xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:control="clr-namespace:MusicEco.Views.Controls"
             x:Class="MusicEco.Views.Controls.SKImageButton">
    <control:SKImageLabel.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnTapped" />
        <PointerGestureRecognizer PointerEntered="OnPointerEntered"
                                  PointerExited="OnPointerExited" />
    </control:SKImageLabel.GestureRecognizers>
</control:SKImageLabel>
