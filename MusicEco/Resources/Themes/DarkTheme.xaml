<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicEco.Resources.Themes.DarkTheme">
    <Color x:Key="TextColor">#DDDDDD</Color>
    <Color x:Key="BorderColor">Gray</Color>
    <Color x:Key="SelectedBorderColor">LawnGreen</Color>
    <Color x:Key="HighlightColor">#20ADA8FF</Color>
    <Color x:Key="ButtonHighlightColor">#40AAD8FF</Color>
    <Color x:Key="ItemAltBackgroundColor">#2A6A6A6A</Color>

    <Color x:Key="PageColor">#FF1C1C1D</Color>
    <Color x:Key="HeaderColor">#FF101011</Color>
    <Color x:Key="MenuColor">Black</Color>
    <Color x:Key="SeparatorColor">Gray</Color>

    <Color x:Key="ActiveTintColor">White</Color>
    <Color x:Key="TintColor">#AAAAAA</Color>
    <Color x:Key="InactiveTintColor">Gray</Color>
</ResourceDictionary>