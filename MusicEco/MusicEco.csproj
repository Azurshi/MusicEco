		<ProjectReference Include="..\MusicEco.Image\MusicEco.Image.csproj" />
		<ProjectReference Include="..\MusicEco.Generators\MusicEco.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />

	</ItemGroup>

	<ItemGroup>
