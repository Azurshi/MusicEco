<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>

		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<Authors>Azurshi</Authors>
		<Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
		<Version Condition="'$(Configuration)' == 'Debug'">0.0.16-dev</Version>
		<Version Condition="'$(Configuration)' == 'Release'">0.0.1</Version>
		<Description> v0.0: Initial version</Description>
	</PropertyGroup>

	<ItemGroup>
	  <Folder Include="Media\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="MusicEco.Tests"/>
	</ItemGroup>
</Project>
